# ==========================================
# FieldShift Environment Variables Template
# ==========================================
# Instructors/Judges: Duplicate this file, rename it to .env.local, 
# and fill in the values to run the application locally.

# [PUBLIC] Base URL of the application. 
# For Vercel production, change this to your actual deployed domain (e.g., https://fieldshift.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [SERVER ONLY] NASA POWER API Endpoint 
# Used by the backend Next.js API routes to fetch climatology data.
NASA_API_BASE_URL=https://power.larc.nasa.gov/api/temporal/climatology/point